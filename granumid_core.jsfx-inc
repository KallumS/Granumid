// granumid_core.jsfx-inc
// Granumid - MIDI sampler for REAPER.
// Core layer: memory map, math helpers, source-data loading and slice analysis.
//
// This file only defines functions (per JSFX import rules, statements placed in
// an imported @init section are not guaranteed to run).  All of the actual
// initialisation happens in Granumid.jsfx.
//
// Copyright (C) 2026  Granumid contributors.  Licensed under the GPL v3.

@init

// ---------------------------------------------------------------------------
// Memory map / constants
// ---------------------------------------------------------------------------
function gm_init_consts()
(
  GM_MAGIC      = 7473;       // magic number expected as first record of a .txt source
  GM_FMT_VER    = 1;

  MAX_NOTES     = 32768;
  NOTE_STRIDE   = 5;          // start(beats), len(beats), pitch, velocity, channel
  BUF_NOTES     = 0;          // .. 163840

  ORD_FWD       = 200000;     // note indices sorted by forward key
  ORD_REV       = 240000;     // note indices sorted by reverse (mirrored) key
  KEY_FWD       = 280000;     // KEY_FWD[i]  = start(i)
  KEY_REV       = 320000;     // KEY_REV[i]  = srclen - (start(i) + len(i))

  MAX_MARKERS   = 256;
  MARKERS       = 360000;     // live marker list (source beats, kept sorted)
  MARKERS_SV    = 360500;     // markers as stored in the project (@serialize)

  MAX_SLICES    = 128;
  SLICES        = 361000;     // stride 2: [startBeat, endBeat]

  MAX_VOICES    = 16;
  MAX_GRAINS    = 256;
  S_STRIDE      = 16;
  STREAMS       = 362000;     // (MAX_VOICES + MAX_GRAINS) * S_STRIDE
  // stream fields
  S_ACTIVE      = 0;
  S_POS         = 1;          // current position on the virtual timeline (beats)
  S_EVI         = 2;          // index into the active order array
  S_DIR         = 3;          // +1 forward, -1 reversed
  S_SEGA        = 4;          // loop return point (virtual beats)
  S_SEGB        = 5;          // end of segment    (virtual beats)
  S_RATE        = 6;          // virtual beats per sample (always >= 0)
  S_LOOPS       = 7;          // completed loop passes
  S_OWNER       = 8;          // owning voice index
  S_TRANSP      = 9;          // extra transpose (grains)
  S_VELSC       = 10;         // extra velocity scale (grains)
  S_ENDSMP      = 11;         // absolute sample at which the stream expires (0 = never)
  S_LOOPEN      = 12;         // 1 if the segment loops
  S_LOOPMODE    = 13;         // 0 fwd, 1 rev, 2 ping-pong
  S_GRAIN       = 14;         // 1 if this stream belongs to a grain

  V_STRIDE      = 32;
  VOICES        = 368000;
  V_STATE       = 0;          // 0 free, 1 held, 2 releasing
  V_KEY         = 1;
  V_VEL         = 2;
  V_CHAN        = 3;
  V_STARTSMP    = 4;          // absolute sample the voice starts sounding
  V_RELSMP      = 5;
  V_RELLVL      = 6;
  V_TRANSP      = 7;
  V_RATESC      = 8;
  V_STREAM      = 9;          // stream index used by non-granular modes
  V_NGRAIN      = 10;
  V_AGE         = 11;
  V_SLICE       = 12;
  V_GNEXT       = 13;         // next grain spawn (absolute samples)
  V_GIDX        = 14;         // rotating grain slot
  V_RNG         = 15;         // per-voice RNG state
  V_ALIVE       = 16;         // 1 while any stream of this voice is still running
  V_SEGA        = 17;         // voice segment bounds in source beats (for grains / UI)
  V_SEGB        = 18;
  V_DIR         = 19;
  V_RATE        = 20;
  V_GBASE       = 21;         // first grain slot owned by this voice
  V_MODE        = 22;         // mode captured at trigger time
  V_SUSHOLD     = 23;         // note-off arrived while the sustain pedal was down

  G_STRIDE      = 8;
  GRAINS        = 369000;
  G_OWNER       = 0;          // owning voice + 1 (0 = free)
  G_BIRTH       = 1;          // absolute sample the current grain cycle started
  G_LIFE        = 2;          // length of the cycle (grain length / density)
  G_ALT         = 3;          // alternating-direction flip-flop

  MAX_SOUND     = 512;
  N_STRIDE      = 4;
  SOUND         = 372000;     // [key, offSample, owner, used]
  N_KEY         = 0;
  N_OFF         = 1;
  N_OWNER       = 2;
  N_USED        = 3;
  SOUNDMAP      = 375000;     // 2048 entries: chan*128+pitch -> slot+1

  MAX_CTLS      = 224;
  C_STRIDE      = 16;
  CTLS          = 378000;

  SCRATCH       = 390000;     // MAX_NOTES scratch for sorting keys

  gm_rng        = 12345;
);

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------
function gm_clamp(x, lo, hi) ( x < lo ? lo : (x > hi ? hi : x) );

// Park-Miller LCG whose state lives in memory so every voice/grain can own one.
function gm_rndm(p)
(
  p[0] < 1 ? p[0] = 1;
  p[0] = (p[0] * 16807) % 2147483647;
  p[0] * 4.656612875e-10;
);

function gm_rnd_bi(p) ( gm_rndm(p) * 2 - 1 );

// ---------------------------------------------------------------------------
// Sorting (iterative heapsort - EEL2 forbids recursion)
// ---------------------------------------------------------------------------
function gm_sift(idx, key, root, n) local(child, tmp)
(
  while (root * 2 + 1 < n) (
    child = root * 2 + 1;
    (child + 1 < n && key[idx[child]] < key[idx[child + 1]]) ? child += 1;
    key[idx[root]] < key[idx[child]] ? (
      tmp = idx[root]; idx[root] = idx[child]; idx[child] = tmp;
      root = child;
    ) : (
      root = n;   // nothing left to do: force the loop to end
    );
  );
);

function gm_heapsort(idx, key, n) local(i, tmp)
(
  n > 1 ? (
    i = (n >> 1) - 1;
    while (i >= 0) ( gm_sift(idx, key, i, n); i -= 1; );
    i = n - 1;
    while (i > 0) (
      tmp = idx[0]; idx[0] = idx[i]; idx[i] = tmp;
      gm_sift(idx, key, 0, i);
      i -= 1;
    );
  );
);

// First index in ord[] whose key is >= pos.  Plain binary search.
function gm_find_ev(ord, key, n, pos) local(lo, hi, mid)
(
  lo = 0; hi = n;
  while (lo < hi) (
    mid = (lo + hi) >> 1;
    key[ord[mid]] < pos ? lo = mid + 1 : hi = mid;
  );
  lo;
);

// ---------------------------------------------------------------------------
// Source data
// ---------------------------------------------------------------------------
function gm_build_order() local(i, np)
(
  i = 0;
  while (i < gm_src_n) (
    np = BUF_NOTES + i * NOTE_STRIDE;
    KEY_FWD[i] = np[0];
    KEY_REV[i] = gm_src_len - (np[0] + np[1]);
    ORD_FWD[i] = i;
    ORD_REV[i] = i;
    i += 1;
  );
  gm_heapsort(ORD_FWD, KEY_FWD, gm_src_n);
  gm_heapsort(ORD_REV, KEY_REV, gm_src_n);
);

function gm_add_note(st, ln, pit, vel, chan) local(np)
(
  gm_src_n < MAX_NOTES ? (
    np = BUF_NOTES + gm_src_n * NOTE_STRIDE;
    np[0] = st;
    np[1] = max(ln, 0.001);
    np[2] = gm_clamp(pit | 0, 0, 127);
    np[3] = gm_clamp(vel | 0, 1, 127);
    np[4] = gm_clamp(chan | 0, 0, 15);
    gm_src_n += 1;
  );
);

// Built-in fallback pattern so the plug-in is usable before anything is imported.
function gm_make_default() local(i, p)
(
  gm_src_n = 0;
  gm_nmark = 0;
  gm_src_len = 4;
  gm_src_tempo = 120;
  gm_src_tsnum = 4;
  gm_src_tsden = 4;
  strcpy(#gm_name, "(built-in pattern)");
  i = 0;
  while (i < 16) (
    p = 60 + (i % 4 == 0 ? 0 : (i % 4 == 1 ? 4 : (i % 4 == 2 ? 7 : 11)));
    gm_add_note(i * 0.25, 0.22, p, 100 - (i % 4) * 8, 0);
    i % 4 == 0 ? gm_add_note(i * 0.25, 0.45, p - 24, 110, 0);
    i += 1;
  );
  gm_build_order();
);

function gm_rd(h)
(
  file_avail(h) > 0 ? ( gm_rd_ok = 1; file_var(h, gm_rd_v); gm_rd_v ) : ( gm_rd_ok = 0; 0 );
);

// Reads a Granumid source file (see docs/FORMAT.md).  Returns 1 on success.
function gm_load_handle(h)
  local(magic, ver, cnt, nmark, i, st, ln, pit, vel, chn, ok)
(
  ok = 0;
  h >= 0 ? (
    magic = gm_rd(h);
    ver   = gm_rd(h);
    (gm_rd_ok && magic == GM_MAGIC && ver >= 1 && ver <= GM_FMT_VER) ? (
      gm_src_n     = 0;
      gm_nmark     = 0;
      gm_src_len   = gm_rd(h);
      cnt          = gm_rd(h) | 0;
      gm_src_tempo = gm_rd(h);
      gm_src_tsnum = gm_rd(h);
      gm_src_tsden = gm_rd(h);
      nmark        = gm_rd(h) | 0;
      gm_rd(h); gm_rd(h); gm_rd(h); gm_rd(h);   // reserved

      gm_src_tempo <= 0 ? gm_src_tempo = 120;
      gm_src_tsnum <= 0 ? gm_src_tsnum = 4;
      gm_src_tsden <= 0 ? gm_src_tsden = 4;

      cnt = gm_clamp(cnt, 0, MAX_NOTES);
      i = 0;
      while (i < cnt && gm_rd_ok) (
        st  = gm_rd(h);
        ln  = gm_rd(h);
        pit = gm_rd(h);
        vel = gm_rd(h);
        chn = gm_rd(h);
        gm_rd_ok ? gm_add_note(st, ln, pit, vel, chn);
        i += 1;
      );

      nmark = gm_clamp(nmark, 0, MAX_MARKERS);
      i = 0;
      while (i < nmark && gm_rd_ok) (
        st = gm_rd(h);
        gm_rd_ok ? ( MARKERS[gm_nmark] = st; gm_nmark += 1; );
        i += 1;
      );

      // Fall back to the last note end if the header length is bogus.
      gm_src_len <= 0 ? (
        gm_src_len = 0;
        i = 0;
        while (i < gm_src_n) (
          gm_src_len = max(gm_src_len, BUF_NOTES[i * NOTE_STRIDE] + BUF_NOTES[i * NOTE_STRIDE + 1]);
          i += 1;
        );
        gm_src_len = max(ceil(gm_src_len), 1);
      );

      gm_src_n > 0 ? ( gm_build_order(); ok = 1; );
    );
  );
  ok;
);

// ---------------------------------------------------------------------------
// Slice analysis
// ---------------------------------------------------------------------------
function gm_slice_push(a, b)
(
  (gm_nslices < MAX_SLICES && b - a > 1.0e-6) ? (
    SLICES[gm_nslices * 2]     = a;
    SLICES[gm_nslices * 2 + 1] = b;
    gm_nslices += 1;
  );
);

// Equal divisions of [a,b].
function gm_slice_divisions(a, b, n) local(i, w)
(
  n = gm_clamp(n | 0, 1, MAX_SLICES);
  w = (b - a) / n;
  i = 0;
  while (i < n) ( gm_slice_push(a + i * w, a + (i + 1) * w); i += 1; );
);

// Fixed musical grid across [a,b]; the final partial slice is kept.
function gm_slice_grid(a, b, g) local(t, nx)
(
  g <= 0 ? g = 1;
  t = a;
  while (t < b - 1.0e-6 && gm_nslices < MAX_SLICES) (
    nx = min(t + g, b);
    gm_slice_push(t, nx);
    t = nx;
  );
);

// Note onsets, clustered with a tolerance derived from the sensitivity control.
// sens 0   -> coarse (1/4 note cluster, only strong onsets)
// sens 100 -> fine   (every distinct note start becomes a slice)
function gm_slice_onsets(a, b, sens) local(i, ni, k, tol, last, nn, minv, vel)
(
  tol  = 0.5 * pow(0.02, sens / 100);          // 0.5 beat .. 0.01 beat
  minv = (1 - sens / 100) * 48;                // ignore quiet notes at low sensitivity
  last = -1e18;
  nn   = 0;
  i    = 0;
  while (i < gm_src_n && gm_nslices < MAX_SLICES) (
    ni  = ORD_FWD[i];
    k   = KEY_FWD[ni];
    vel = BUF_NOTES[ni * NOTE_STRIDE + 3];
    (k >= a - 1.0e-6 && k < b - 1.0e-6 && vel >= minv && k - last > tol) ? (
      nn > 0 ? gm_slice_push(last, k) : (k > a + 1.0e-6 ? gm_slice_push(a, k));
      last = k;
      nn  += 1;
    );
    i += 1;
  );
  nn > 0 ? gm_slice_push(last, b) : gm_slice_push(a, b);
);

// New slice whenever the leading (highest) pitch of an onset group changes.
function gm_slice_pitch(a, b, sens)
  local(i, ni, k, p, tol, gstart, gtop, prevtop, last)
(
  tol     = 0.5 * pow(0.02, sens / 100);
  gstart  = -1e18;
  gtop    = -1;
  prevtop = -1e18;
  last    = a;
  i       = 0;
  while (i < gm_src_n && gm_nslices < MAX_SLICES) (
    ni = ORD_FWD[i];
    k  = KEY_FWD[ni];
    p  = BUF_NOTES[ni * NOTE_STRIDE + 2];
    (k >= a - 1.0e-6 && k < b - 1.0e-6) ? (
      (gtop < 0 || k - gstart > tol) ? (
        // the previous onset group is complete - did its leading pitch change?
        (gtop >= 0 && gtop != prevtop) ? (
          gstart > last + 1.0e-6 ? ( gm_slice_push(last, gstart); last = gstart; );
          prevtop = gtop;
        );
        gstart = k;
        gtop   = p;
      ) : (
        gtop = max(gtop, p);
      );
    );
    i += 1;
  );
  (gtop >= 0 && gtop != prevtop && gstart > last + 1.0e-6) ? ( gm_slice_push(last, gstart); last = gstart; );
  gm_slice_push(last, b);
  gm_nslices == 0 ? gm_slice_push(a, b);
);

// User markers (imported with the file or placed in the editor).
function gm_slice_markers(a, b) local(i, t, last, n)
(
  // markers are kept sorted by gm_marker_add()
  last = a;
  n    = 0;
  i    = 0;
  while (i < gm_nmark && gm_nslices < MAX_SLICES) (
    t = MARKERS[i];
    (t > a + 1.0e-6 && t < b - 1.0e-6) ? ( gm_slice_push(last, t); last = t; n += 1; );
    i += 1;
  );
  gm_slice_push(last, b);
);

function gm_build_slices(a, b, method, div, grid, sens) local(g)
(
  gm_nslices = 0;
  b - a < 1.0e-4 ? b = a + 1.0e-4;
  method == 0 ? gm_slice_divisions(a, b, div) :
  method == 1 ? (
    g = grid == 0 ? 0.125 : grid == 1 ? 0.25 : grid == 2 ? 0.5 :
        grid == 3 ? 1     : grid == 4 ? 2    :
        grid == 5 ? gm_src_tsnum * 4 / gm_src_tsden :
                    gm_src_tsnum * 8 / gm_src_tsden;
    gm_slice_grid(a, b, g);
  ) :
  method == 2 ? gm_slice_onsets(a, b, sens) :
  method == 3 ? gm_slice_pitch(a, b, sens) :
                gm_slice_markers(a, b);
  gm_nslices == 0 ? gm_slice_push(a, b);
);

// ---------------------------------------------------------------------------
// Marker editing (used by the UI, persisted through @serialize)
// ---------------------------------------------------------------------------
function gm_marker_add(t) local(i, j)
(
  gm_nmark < MAX_MARKERS ? (
    i = 0;
    while (i < gm_nmark && MARKERS[i] < t) ( i += 1; );
    j = gm_nmark;
    while (j > i) ( MARKERS[j] = MARKERS[j - 1]; j -= 1; );
    MARKERS[i] = t;
    gm_nmark += 1;
  );
);

function gm_marker_remove_near(t, tol) local(i, best, bd, d)
(
  best = -1; bd = tol;
  i = 0;
  while (i < gm_nmark) (
    d = abs(MARKERS[i] - t);
    d < bd ? ( bd = d; best = i; );
    i += 1;
  );
  best >= 0 ? (
    while (best < gm_nmark - 1) ( MARKERS[best] = MARKERS[best + 1]; best += 1; );
    gm_nmark -= 1;
    1;
  ) : 0;
);
